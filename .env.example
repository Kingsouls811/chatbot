# Copia este archivo como .env y ajusta si hace falta.

# true = usa la IA local para entender mensajes libres. false = solo menú.
OLLAMA_ACTIVO=true
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_MS=30000

# Opcional: navegador para WhatsApp Web. Si no se pone, busca Chrome o Edge instalados.
# CHROME_PATH=C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe

# Opcional: carpeta donde se guarda la sesión de WhatsApp (default: ~/.botiquin-bot).
# Debe ser una ruta corta: en Windows una ruta larga hace que WhatsApp Web truene.
# SESION_PATH=C:\botiquin-sesion
